input {
    keyboard {
        xkb {
            layout "us" 
            options "ctrl:nocaps,shift:both_capslock"
        }
    }
}

// chinese input 
spawn-at-startup "fcitx5" "-d"

layout {
    focus-ring {
        on
        width 2
        active-color "#434241"
        inactive-color "#2a2929"
        urgent-color "#c2180c"
    }
}